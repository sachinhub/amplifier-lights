# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/amplifier_light
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI Crawler Settings
GPTBOT_RATE_LIMIT=200
CLAUDEBOT_RATE_LIMIT=200
PERPLEXITYBOT_RATE_LIMIT=200

# API Configuration
API_VERSION=v1
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Cache Settings
CACHE_TTL=300
AVAILABILITY_CACHE_TTL=60