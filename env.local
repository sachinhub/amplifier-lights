# Local Development Environment
NODE_ENV=development
PORT=3000

# Database - Local PostgreSQL
DATABASE_URL=postgresql://Sachin@localhost:5432/amplifier_light

# Redis - Local Redis (if running)
REDIS_URL=redis://localhost:6379

# API Configuration
API_VERSION=v1
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
GPTBOT_RATE_LIMIT=200
CLAUDEBOT_RATE_LIMIT=200
PERPLEXITYBOT_RATE_LIMIT=200

# Caching
CACHE_TTL=300
AVAILABILITY_CACHE_TTL=60
